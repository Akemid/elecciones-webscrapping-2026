# ONPE API endpoint discovered via `python scripts/discover_api.py`
ONPE_API_URL=

# Session headers captured during discovery (JSON string)
# Example: {"User-Agent": "...", "Referer": "..."}
ONPE_SESSION_HEADERS={}

# Scraping interval in minutes — allowed values: 5, 10, 15
SCRAPER_INTERVAL_MINUTES=10

# Directory for JSON snapshot files and SQLite database
DATA_DIR=./data

# Optional: override default SQLite path (defaults to {DATA_DIR}/election.db)
# DB_PATH=./data/election.db
